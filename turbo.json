{
	"$schema": "https://turborepo.com/schema.json",
	"tasks": {
		"web#build": {
			"inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/schema/**", "$TURBO_ROOT$/content/dist/**"],
			"outputs": ["../server/web/dist/**"]
		},
		"server#build": { "dependsOn": ["web#build"], "outputs": ["boso"] },
		"test": {},
		"lint": {},
		"dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["BOSO_*"]
		}
	}
}
