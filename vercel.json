{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "PACKS_URL=https://github.com/Mqdd27/boso/releases/download/packs/packs.tar.gz npm run build -w web",
  "outputDirectory": "apps/server/web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
